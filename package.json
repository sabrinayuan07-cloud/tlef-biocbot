{
  "name": "tlef-biocbot",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "cross-env NODE_ENV=development nodemon src/server.js",
    "dev:client": "browser-sync start --proxy 'http://localhost:8050' --files 'public' --browser 'Google Chrome'",
    "grant:system-admin": "node scripts/grant-system-admin.js",
    "seed:local-lms-grades": "node scripts/seed-local-lms-grades.js --yes",
    "encryption:canary": "node scripts/check-chat-encryption.js",
    "encryption:plan": "ubc-genai-encryption plan --config ./src/config/encryption.js",
    "encryption:plan:all": "ubc-genai-encryption plan --config ./src/config/encryption.js --all-configured",
    "encryption:status": "ubc-genai-encryption status --config ./src/config/encryption.js",
    "encryption:migrate": "ubc-genai-encryption migrate --config ./src/config/encryption.js",
    "encryption:migrate:dry-run": "ubc-genai-encryption migrate --config ./src/config/encryption.js --dry-run",
    "encryption:verify": "ubc-genai-encryption verify --config ./src/config/encryption.js",
    "encryption:verify:all": "ubc-genai-encryption verify --config ./src/config/encryption.js --all-configured",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.js",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:unit:monocart": "jest --config jest.monocart.config.js",
    "test:monocart": "playwright test",
    "test:monocart:chat-rag": "playwright test tests/e2e/chat-rag-documents.spec.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:report:monocart": "monocart show-report monocart-report/index.html",
    "test:report:coverage": "monocart show-report coverage-reports/e2e/index.html",
    "test:report:unit": "monocart show-report coverage-reports/unit-monocart/index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "1.19.0",
    "bad-words": "^3.0.4",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-session": "^1.18.0",
    "js-tiktoken": "^1.0.21",
    "mongodb": "^6.17.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-saml": "^3.2.4",
    "passport-ubcshib": "0.1.4",
    "ubc-genai-toolkit-chunking": "^0.1.0",
    "ubc-genai-toolkit-core": "^0.1.0",
    "ubc-genai-toolkit-document-parsing": "^0.3.1",
    "ubc-genai-toolkit-embeddings": "^0.2.0",
    "ubc-genai-toolkit-llm": "^0.7.0"
  },
  "optionalDependencies": {
    "@ubc/genai-toolkit-encryption": "0.1.0",
    "@ubc/ubc-genai-toolkit-course-list-sync": "^0.1.3",
    "@ubc/ubc-genai-toolkit-lms-integration": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "browser-sync": "^3.0.4",
    "cross-env": "^7.0.3",
    "delegates": "^1.0.0",
    "jest": "^30.4.2",
    "jest-monocart-coverage": "^1.1.1",
    "monocart-reporter": "^2.11.2",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.2.2"
  }
}
